{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codelit",
  "version": "0.1.2",
  "identifier": "io.codelit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codelit",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "externalBin": [
      "binaries/codelit-mlx-helper"
    ],
    "resources": {
      "resources/app-store/PrivacyInfo.xcprivacy": "PrivacyInfo.xcprivacy",
      "resources/mlx/build-manifest.json": "build-manifest.json",
      "../native/mlx-helper/model-manifest.json": "model-manifest.json",
      "resources/mlx/mlx-swift_Cmlx.bundle": "mlx-swift_Cmlx.bundle",
      "resources/mlx/swift-transformers_Hub.bundle": "swift-transformers_Hub.bundle",
      "resources/mlx/swift-crypto_Crypto.bundle": "swift-crypto_Crypto.bundle"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "bundleVersion": "16"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
